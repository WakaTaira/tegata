    "test:acceptance": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@types/node": "^24.0.0",
    "playwright-core": "1.61.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
